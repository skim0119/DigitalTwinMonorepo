[Unit]
Description=Spirob Experiment API
Wants=spirob-gpio@%i.service spirob-mocap@%i.service
After=spirob-gpio@%i.service spirob-mocap@%i.service

[Service]
User=%i
WorkingDirectory=/home/%i/spirob_py_code
ExecStart=/bin/bash -c 'source /home/%i/ros2_spirob_ws/install/setup.bash && exec .experiment-venv/bin/experiment-api --force-only --homing-script debug/homing.py'
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
